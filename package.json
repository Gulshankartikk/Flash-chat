{
  "name": "flash-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Flash Chat - Realtime Messaging, Voice/Video Calling & AI Assistant",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend start",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend start",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test -- --watchAll=false",
    "test": "npm run test:backend && npm run test:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "cloudinary": "^2.9.0",
    "framer-motion": "^12.40.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "react-hook-form": "^7.80.0",
    "react-icons": "^5.6.0",
    "yup": "^1.7.1"
  }
}
