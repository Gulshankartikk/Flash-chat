# ==========================================
# Flash Chat Server Environment Configuration
# ==========================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Connection String (e.g., local MongoDB or MongoDB Atlas URI)
MONGO_URI=mongodb://localhost:27017/flashchat

# JWT Secret (minimum 16 characters, 64-char hex string recommended)
JWT_SECRET=super_secret_flash_chat_jwt_key_32_characters_long

# Frontend Client URL (for CORS & Cookie headers)
CLIENT_URL=http://localhost:5173

# ------------------------------------------
# Google OAuth 2.0 Credentials
# ------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ------------------------------------------
# Gmail / Nodemailer Configuration
# ------------------------------------------
# Target Gmail address used to dispatch notification emails
GMAIL_USER=your-email@gmail.com

# OPTION A: OAuth2 Refresh Token (Recommended for Google Cloud OAuth)
# Generated from Google OAuth 2.0 Playground with Gmail API v1 scope
GMAIL_REFRESH_TOKEN=your-oauth2-refresh-token

# OPTION B: App Password Fallback (Alternative if OAuth2 is not set up)
# Generated in Google Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=your-16-char-app-password

# ------------------------------------------
# Logging & Optional Redis Cache
# ------------------------------------------
# Logging level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
LOG_LEVEL=info

# Optional Redis connection URL (leave empty to use fast in-memory store)
REDIS_URL=
