# ==============================================================================
# Flash Chat Backend Server Environment Configuration (.env.example)
# Copy this file to server/.env (or root .env) before running the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Client Frontend URL for CORS, CSRF, and Cookie handling.
# In development: http://localhost:5173
# In production: https://flash-chat.vercel.app (supports comma-separated origins)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHE
# ------------------------------------------------------------------------------
# MongoDB Connection String
# Development: mongodb://localhost:27017/flashchat
# Production (MongoDB Atlas): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flashchat?retryWrites=true&w=majority&appName=FlashChat
MONGO_URI=mongodb://localhost:27017/flashchat

# Redis URL (Optional in dev, recommended in production for Socket.IO multi-node / rate-limiting)
# Examples:
#   Upstash / Render Redis: rediss://default:<password>@<host>:<port>
#   Local Docker: redis://localhost:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & TOKENS (CRITICAL)
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret keys.
# In production, default placeholders will trigger a startup safety validation error.
# Generate via: openssl rand -base64 32
JWT_ACCESS_SECRET=flash_chat_super_secure_access_secret_key_32_chars_min
JWT_REFRESH_SECRET=flash_chat_super_secure_refresh_secret_key_32_chars_min

# Legacy JWT secret alias for backward compatibility
JWT_SECRET=flash_chat_super_secure_access_secret_key_32_chars_min

# Google OAuth 2.0 Credentials (Optional: required for Google Sign-In)
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# HMAC secret used for phone privacy hashing
PHONE_HASH_SECRET=flash_chat_super_secure_phone_hmac_secret_32_chars_min

# ------------------------------------------------------------------------------
# 4. EMAIL & NOTIFICATIONS (Nodemailer SMTP)
# ------------------------------------------------------------------------------
# Used for Email OTP verification, welcome emails, password resets, and digests.
# If credentials are blank in development, OTPs are safely logged to the console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
MAIL_FROM=Flash Chat <no-reply@flashchat.io>

# Legacy Gmail aliases (alternative to SMTP_* above)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password
GMAIL_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 5. TWILIO SMS OTP (Optional)
# ------------------------------------------------------------------------------
# For real SMS OTP dispatch. Leave blank to simulate OTPs in dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 6. FLASH AI / GOOGLE GEMINI (AI Assistant, Smart Replies & RAG)
# ------------------------------------------------------------------------------
# Obtain your API key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-3.8-flash
AI_DAILY_LIMIT=50
AI_MAX_INPUT_CHARS=8000

# ------------------------------------------------------------------------------
# 7. CLOUDINARY MEDIA STORE
# ------------------------------------------------------------------------------
# Cloud storage for user avatars, chat attachments, audio waveforms, reels, and stories.
# Obtain from Cloudinary Dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 8. WEBRTC STUN / TURN (Audio & Video Calling)
# ------------------------------------------------------------------------------
# Public STUN servers for NAT discovery (comma-separated)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Production TURN Relay (Coturn / Metered.ca / OpenRelay / Twilio Network Traversal)
# Option A: Static Credentials (e.g. Metered or static Coturn)
# TURN_URL=turn:standard.relay.metered.ca:80
# TURN_USERNAME=your-metered-username
# TURN_CREDENTIAL=your-metered-credential

# Option B: Ephemeral HMAC-SHA1 Time-Limited Secret (Standard Coturn / RFC 5766)
# TURN_URL=turn:your-coturn-domain.com:3478
# TURN_SECRET=your-coturn-static-auth-secret
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=

# ------------------------------------------------------------------------------
# 9. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Generate pair using: npm --prefix server run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@flashchat.io

# ------------------------------------------------------------------------------
# 10. SYSTEM & LOGGING
# ------------------------------------------------------------------------------
# Logging level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
LOG_LEVEL=info
