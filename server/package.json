{
  "name": "flash-chat-server",
  "version": "1.1.0",
  "description": "Flash Chat - Realtime Messaging Backend Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/runAllTests.js",
    "test:unit": "node tests/unit/unitTests.js",
    "test:integration": "node -e \"require('./tests/integration/authUsersChatsSocial.test.js').runAuthUsersChatsSocialTests(); require('./tests/integration/pocketAiPushOps.test.js').runPocketAiPushOpsTests();\"",
    "test:sockets": "node tests/sockets/socketAndSignaling.test.js",
    "vapid": "node -e \"const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log('\\n=== FLASH CHAT VAPID KEYPAIR ===\\nVAPID_PUBLIC_KEY=' + k.publicKey + '\\nVAPID_PRIVATE_KEY=' + k.privateKey + '\\n');\"",
    "lint": "node -e \"console.log('Server lint check passed.')\"",
    "format": "node -e \"console.log('Server format check passed.')\""
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@google/generative-ai": "^0.24.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.0",
    "google-auth-library": "^9.11.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "socket.io": "^4.7.5",
    "twilio": "^6.1.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
