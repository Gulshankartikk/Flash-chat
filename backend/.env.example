# Server Port & Environment
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/flash-chat

# JWT Secret Keys
JWT_SECRET=replace_with_a_secure_jwt_secret_minimum_32_characters
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret_minimum_32_characters

# Cloudinary (Media & Profile Photo Uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Twilio (SMS OTP Authentication - Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SERVICE_SID=your_twilio_verify_service_sid

# Google Gemini AI (Flash AI Assistant & Thread Summarizer)
GEMINI_API_KEY=your_google_gemini_api_key
