# ==============================================================================
# Flash Chat Environment Variables (.env.example)
# Copy this file to .env (or server/.env) before running the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Operating environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend HTTP and WebSocket port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/flashchat
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/flashchat
MONGO_URI=mongodb://localhost:27017/flashchat

# JWT Secret key for signing authorization cookies (minimum 16 chars)
JWT_SECRET=super_secret_flash_chat_jwt_key_secure_32_chars_minimum

# Frontend Web Application URL (Allowed CORS origin and redirection)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 ("Continue with Google" / Authorize flow)
# ------------------------------------------------------------------------------
# Obtained from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 3. GMAIL & NODEMAILER CONFIGURATION
# ------------------------------------------------------------------------------
# Sender Gmail address
GMAIL_USER=your-email@gmail.com

# OPTION A (Recommended): OAuth2 Refresh Token
# Generated via Google OAuth 2.0 Playground (scope: https://mail.google.com/)
GMAIL_REFRESH_TOKEN=your-gmail-oauth2-refresh-token

# OPTION B (Fastest Fallback): Google 16-character App Password
# Generated via Google Account > Security > 2-Step Verification > App passwords
GMAIL_APP_PASSWORD=your-16-character-app-password

# ------------------------------------------------------------------------------
# 4. LOGGING & OPTIONAL REDIS CACHE
# ------------------------------------------------------------------------------
# Pino Logging level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
LOG_LEVEL=info

# Optional Redis connection URI for Socket.IO multi-node adapter and caching.
# Disabled by default so app runs standalone without requiring Redis.
# Example: redis://localhost:6379
REDIS_URL=
