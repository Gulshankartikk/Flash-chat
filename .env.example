# ==============================================================================
# Flash Chat Super-App Environment Variables (.env.example)
# Copy this file to .env (or server/.env) before running the application.
# The app automatically runs in dev mode with simulated OTPs if keys are empty.
# ==============================================================================

# Core Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/flashchat
REDIS_URL=redis://localhost:6379
CLIENT_URL=http://localhost:5173

# JWT Secrets (Minimum 32 characters)
JWT_ACCESS_SECRET=flash_chat_super_secure_access_secret_key_32_chars_min
JWT_REFRESH_SECRET=flash_chat_super_secure_refresh_secret_key_32_chars_min

# Twilio SMS / Phone OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Email / Nodemailer SMTP OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Flash Chat <no-reply@flashchat.io>

# Google Gemini AI
GEMINI_API_KEY=

# Cloudinary Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging Level
LOG_LEVEL=info
