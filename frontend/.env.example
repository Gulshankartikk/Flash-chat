# Backend API Base URL
REACT_APP_API_URL=http://localhost:8000

# Google OAuth 2.0 Client ID (Matches backend GOOGLE_CLIENT_ID)
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Optional Custom WebRTC STUN / TURN Configuration
# (Defaults to Google public STUN servers if left blank)
REACT_APP_STUN_SERVER=stun:stun.l.google.com:19302
REACT_APP_TURN_SERVER=
REACT_APP_TURN_USERNAME=
REACT_APP_TURN_CREDENTIAL=
