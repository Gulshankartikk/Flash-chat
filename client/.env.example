# ==============================================================================
# Flash Chat Client Environment Variables (.env.example)
# Configure these in your Vercel Project Settings > Environment Variables
# ==============================================================================

# Backend REST API endpoint (No trailing slash)
# Leave blank for local development to use Vite's built-in dev proxy
# In production on Vercel, set to your Render or persistent server URL:
VITE_API_URL=https://flash-chat-server.onrender.com

# Realtime WebSocket/Socket.IO Server URL (No trailing slash)
# Usually matches VITE_API_URL. If omitted, it automatically falls back to VITE_API_URL.
VITE_SOCKET_URL=https://flash-chat-server.onrender.com

# Google OAuth 2.0 Web Client ID
# Make sure to add your Vercel production and preview domains to
# Google Cloud Console > APIs & Services > Credentials > Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
